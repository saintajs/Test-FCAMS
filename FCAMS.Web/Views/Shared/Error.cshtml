@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Error";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>Something went wrong - FCAMS</title>
<link href="~/Content/site.css" rel="stylesheet" /></head>
<body>
    <main class="container error-page">
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred while processing your request. Our team has been notified via the
           application's exception log, and someone will look into it.</p>
        <p><a href="~/">Return to the dashboard</a></p>
    </main>
</body>
</html>
