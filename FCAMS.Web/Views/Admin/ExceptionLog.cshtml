@model System.Collections.Generic.List<FCAMS.Web.Models.ExceptionLogEntry>
@{
    ViewBag.Title = "Exception Log";
}
<div class="page-header">
    <h1>Exception Log</h1>
</div>

<div class="filter-bar">
    <a class="severity-filter @((bool)ViewBag.UnresolvedOnly ? "active" : "")" href="@Url.Action("ExceptionLog", new { unresolvedOnly = true })">Unresolved Only</a>
    <a class="severity-filter @(!(bool)ViewBag.UnresolvedOnly ? "active" : "")" href="@Url.Action("ExceptionLog", new { unresolvedOnly = false })">All</a>
</div>

@if (Model.Count == 0)
{
    <p class="muted">No exceptions recorded. That's a good sign.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr><th>When</th><th>Source</th><th>Severity</th><th>Message</th><th>Request URL</th></tr>
        </thead>
        <tbody>
            @foreach (var ex in Model)
            {
                <tr>
                    <td>@ex.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@ex.Source</td>
                    <td><span class="severity-badge severity-@ex.Severity.ToLower()">@ex.Severity</span></td>
                    <td class="detail-cell">@ex.Message</td>
                    <td class="detail-cell">@(ex.RequestUrl ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
