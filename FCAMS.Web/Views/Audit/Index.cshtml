@model System.Collections.Generic.List<FCAMS.Web.Models.AuditEngagement>
@{
    ViewBag.Title = "Audit Engagements";
}
<div class="page-header">
    <h1>Audit Engagements</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary">+ New Engagement</a>
</div>

@if (Model.Count == 0)
{
    <p class="muted">No audit engagements have been created yet.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr><th>Name</th><th>Department</th><th>Lead Auditor</th><th>Period</th><th>Status</th><th>Open Findings</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><a href="@Url.Action("Details", new { id = a.AuditId })">@a.AuditName</a></td>
                    <td>@a.DepartmentName</td>
                    <td>@a.LeadAuditorName</td>
                    <td>@a.PeriodStart.ToString("MMM d, yyyy") &ndash; @a.PeriodEnd.ToString("MMM d, yyyy")</td>
                    <td><span class="status-badge status-@a.Status.ToLower()">@a.Status</span></td>
                    <td>@a.OpenFindingCount</td>
                </tr>
            }
        </tbody>
    </table>
}
