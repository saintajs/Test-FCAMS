<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <configSections>
  </configSections>

  <!-- ========================================================= -->
  <!-- DATABASE                                                  -->
  <!-- ========================================================= -->

  <connectionStrings>
    <add
      name="FcamsDbContext"
      connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=FCAMS;Integrated Security=True;MultipleActiveResultSets=True;"
      providerName="System.Data.SqlClient" />
  </connectionStrings>


  <!-- ========================================================= -->
  <!-- APPLICATION SETTINGS                                      -->
  <!-- ========================================================= -->

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />

    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>


  <!-- ========================================================= -->
  <!-- ASP.NET                                                   -->
  <!-- ========================================================= -->

  <system.web>

    <compilation
      debug="true"
      targetFramework="4.8" />

    <httpRuntime
      targetFramework="4.8"
      maxRequestLength="10240" />

    <!-- Forms Authentication -->
    <authentication mode="Forms">
      <forms
        loginUrl="~/Account/Login"
        cookieless="UseCookies"
        timeout="2880" />
    </authentication>

    <!-- Show detailed errors during development -->
    <customErrors mode="Off" />

    <!-- ASP.NET MVC / Razor -->
    <pages controlRenderingCompatibilityVersion="4.0">

      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="FCAMS.Web.Models" />
      </namespaces>

    </pages>

  </system.web>


  <!-- ========================================================= -->
  <!-- IIS                                                        -->
  <!-- ========================================================= -->

  <system.webServer>

    <validation
      validateIntegratedModeConfiguration="false" />

    <modules
      runAllManagedModulesForAllRequests="true" />

  </system.webServer>


  <!-- ========================================================= -->
  <!-- ASSEMBLY BINDING REDIRECTS                                -->
  <!-- ========================================================= -->

  <runtime>

    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

      <!-- ===================================================== -->
      <!-- Microsoft.Web.Infrastructure                           -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="Microsoft.Web.Infrastructure"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-2.0.0.0"
          newVersion="2.0.0.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- System.Web.Helpers                                      -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="System.Web.Helpers"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-3.0.0.0"
          newVersion="3.0.0.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- System.Web.WebPages                                     -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="System.Web.WebPages"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-3.0.0.0"
          newVersion="3.0.0.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- System.Web.WebPages.Razor                               -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="System.Web.WebPages.Razor"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-3.0.0.0"
          newVersion="3.0.0.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- System.Web.Razor                                        -->
      <!-- THIS FIXES THE CURRENT ERROR                           -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="System.Web.Razor"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-3.0.0.0"
          newVersion="3.0.0.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- System.Web.Mvc                                          -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="System.Web.Mvc"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-5.2.9.0"
          newVersion="5.2.9.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- Newtonsoft.Json                                         -->
      <!-- MSBuild reported this conflict during build             -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="Newtonsoft.Json"
          publicKeyToken="30ad4fe6b2a6aeed"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-13.0.0.0"
          newVersion="13.0.0.0" />

      </dependentAssembly>


      <!-- ===================================================== -->
      <!-- WebGrease                                               -->
      <!-- ===================================================== -->

      <dependentAssembly>

        <assemblyIdentity
          name="WebGrease"
          publicKeyToken="31bf3856ad364e35"
          culture="neutral" />

        <bindingRedirect
          oldVersion="0.0.0.0-1.6.5135.21930"
          newVersion="1.6.5135.21930" />

      </dependentAssembly>

    </assemblyBinding>

  </runtime>


  <!-- ========================================================= -->
  <!-- ALLOW ANONYMOUS ACCESS TO LOGIN                           -->
  <!-- ========================================================= -->

  <location path="Account/Login">

    <system.web>

      <authorization>
        <allow users="*" />
      </authorization>

    </system.web>

  </location>

</configuration>